{%- comment -%}
  Password page (shown when storefront password protection is enabled
  in Shopify admin). Pre-launch this is what visitors see.
{%- endcomment -%}

<section class="container" style="padding: 96px 0; max-width: 480px; text-align: center;">
  <a href="/" style="display: inline-flex; align-items: center; gap: 12px; margin-bottom: 32px;">
    {% render 'shield-logo', size: 'lg' %}
    <span style="font-weight: 800; font-size: 22px;">{{ shop.name }}</span>
  </a>

  <span style="font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); font-weight: 800;">Coming soon</span>
  <h1 style="font-size: clamp(32px, 4vw, 48px); margin: 12px 0 14px; letter-spacing: -0.02em; line-height: 1; font-weight: 800;">
    The new {{ shop.name }} is almost ready.
  </h1>
  <p style="color: var(--grey); font-size: 17px; margin: 0 0 32px;">
    Manufacturing in Alliance, Ohio since 1938. Have a password?
  </p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div style="background: #FEE2E2; color: #B91C1C; padding: 14px; border-radius: 12px; margin-bottom: 18px; font-size: 14px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
    <div style="display: flex; gap: 8px;">
      <input type="password" name="password" autocomplete="off" required placeholder="Password" style="flex: 1; padding: 14px 18px; border: 2px solid var(--line); border-radius: 999px; font-size: 15px; outline: none;">
      <button type="submit" class="btn btn--red btn--lg">Enter</button>
    </div>
  {%- endform -%}

  <hr style="border: 0; border-top: 1px solid var(--line); margin: 32px 0;">

  <p style="color: var(--grey); font-size: 13px;">
    Not the password? Email <a href="mailto:{{ settings.contact_email | default: 'info@damonq.com' }}" style="color: var(--red); font-weight: 700;">{{ settings.contact_email | default: 'info@damonq.com' }}</a> for access.
  </p>
</section>
