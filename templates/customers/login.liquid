<section class="container" style="padding: 96px 0; max-width: 440px;">
  <h1 style="font-size: 36px; margin: 0 0 24px; letter-spacing: -0.02em; line-height: 1; font-weight: 800; text-align: center;">{{ 'customer.login.title' | t }}</h1>

  {%- form 'customer_login' -%}
    {%- if form.errors -%}
      <div style="background: #FEE2E2; color: #B91C1C; padding: 14px; border-radius: 12px; margin-bottom: 18px; font-size: 14px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <label for="customer_email" style="display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); font-weight: 800; margin-bottom: 6px;">{{ 'customer.login.email' | t }}</label>
    <input type="email" id="customer_email" name="customer[email]" autocomplete="email" required style="width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 15px; outline: none; margin-bottom: 14px;">

    <label for="customer_password" style="display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); font-weight: 800; margin-bottom: 6px;">{{ 'customer.login.password' | t }}</label>
    <input type="password" id="customer_password" name="customer[password]" autocomplete="current-password" required style="width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 15px; outline: none; margin-bottom: 18px;">

    <button type="submit" class="btn btn--red btn--block btn--lg">{{ 'customer.login.submit' | t }}</button>

    <div style="text-align: center; margin-top: 16px; font-size: 13px;">
      <a href="{{ routes.account_recover_url }}" style="color: var(--red); font-weight: 700;">{{ 'customer.login.forgot_password' | t }}</a>
    </div>
  {%- endform -%}

  <hr style="border: 0; border-top: 1px solid var(--line); margin: 28px 0;">

  <p style="text-align: center; font-size: 14px; color: var(--grey);">
    New facility?
    <a href="{{ routes.account_register_url }}" style="color: var(--red); font-weight: 700;">{{ 'customer.login.create_account' | t }}</a>
  </p>
</section>
