<section class="container" style="padding: 96px 0; max-width: 440px;">
  <h1 style="font-size: 36px; margin: 0 0 14px; letter-spacing: -0.02em; line-height: 1; font-weight: 800; text-align: center;">Activate your account</h1>
  <p style="color: var(--grey); text-align: center; margin: 0 0 28px;">Pick a password to finish setting up your Damon account.</p>

  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <div style="background: #FEE2E2; color: #B91C1C; padding: 14px; border-radius: 12px; margin-bottom: 18px; font-size: 14px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <label style="display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); font-weight: 800; margin-bottom: 6px;">Password</label>
    <input type="password" name="customer[password]" required autocomplete="new-password" style="width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 15px; outline: none; margin-bottom: 14px;">

    <label style="display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); font-weight: 800; margin-bottom: 6px;">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" required autocomplete="new-password" style="width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 15px; outline: none; margin-bottom: 18px;">

    <button type="submit" class="btn btn--red btn--block btn--lg">Activate account</button>
    <button type="submit" name="decline" class="btn btn--outline btn--block" style="margin-top: 8px;">Decline invitation</button>
  {%- endform -%}
</section>
