{%- comment -%}
  Business-card-style contact tile. Used on the My Contacts page and
  anywhere else we render a Damon team member.

  Accepts:
    - eyebrow (required): role label above the name (e.g. "Sales representative")
    - name (required): full name
    - title (optional): job title / department subtext
    - territory (optional): territory / service area
    - phone (optional): tel: link
    - email (optional): mailto: link
    - photo (optional): image_url-compatible object; falls back to initials
    - certifications (optional): array of strings (renders as pills)
{%- endcomment -%}

{%- liquid
  assign initials = name | split: ' ' | map: 'first' | join: ''
  assign initials = initials | slice: 0, 2 | upcase
  if initials == blank
    assign initials = '•'
  endif
-%}

<article class="contact-card">
  {%- if eyebrow != blank -%}
    <div class="contact-card__eyebrow">{{ eyebrow }}</div>
  {%- endif -%}
  <div class="contact-card__avatar">
    {%- if photo -%}
      {{ photo | image_url: width: 200 | image_tag: alt: name, loading: 'lazy', class: 'contact-card__photo' }}
    {%- else -%}
      <span class="contact-card__initials" aria-hidden="true">{{ initials }}</span>
    {%- endif -%}
  </div>
  <h3 class="contact-card__name">{{ name }}</h3>
  {%- if title != blank -%}
    <p class="contact-card__title">{{ title }}</p>
  {%- endif -%}
  {%- if territory != blank -%}
    <p class="contact-card__territory">{{ territory }}</p>
  {%- endif -%}
  {%- if certifications and certifications.size > 0 -%}
    <ul class="contact-card__certs">
      {%- for cert in certifications -%}
        <li>{{ cert }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  <div class="contact-card__actions">
    {%- if phone != blank -%}
      <a class="btn btn--red" href="tel:{{ phone | url_encode }}">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {{ phone }}
      </a>
    {%- endif -%}
    {%- if email != blank -%}
      <a class="btn btn--outline" href="mailto:{{ email }}">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        Email
      </a>
    {%- endif -%}
  </div>
</article>
