{%- comment -%}
  Q Team directory — "Ask for the chemist. You get the chemist."
  Person cards (image, role, name, specialty) as `person` blocks, plus a
  CTA row. Names and photos are placeholders until the real directory lands.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign anchor = s.anchor_id | default: 'qteam'
-%}

<section class="page-section qteam" id="{{ anchor }}">
  <div class="container">
    {%- if s.eyebrow != blank -%}
      <span class="eyebrow">
        {%- if s.eyebrow_no != blank -%}<span>{{ s.eyebrow_no }}</span>{%- endif -%}
        <span class="eyebrow__rule" aria-hidden="true"></span>
        <span>{{ s.eyebrow }}</span>
      </span>
    {%- endif -%}

    <div class="page-section__head">
      <h2 class="page-section__title">{{ s.heading }}</h2>
      {%- if s.description != blank -%}
        <p class="page-section__desc">{{ s.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="qteam__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- liquid
            assign person_alt = b.image_alt
            if person_alt == blank
              assign person_alt = b.name
            endif
          -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <div class="team-card__photo">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(max-width: 620px) 100vw, (max-width: 1000px) 50vw, 25vw', alt: person_alt }}
              {%- else -%}
                <div class="photo-slot">
                  <span class="photo-slot__label">{{ b.image_placeholder }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="team-card__body">
              {%- if b.role != blank -%}<div class="team-card__role">{{ b.role }}</div>{%- endif -%}
              <div class="team-card__name">{{ b.name }}</div>
              {%- if b.spec != blank -%}<div class="team-card__spec">{{ b.spec }}</div>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.cta_text != blank or s.note != blank -%}
      <div class="page-section__ctas">
        {%- if s.cta_text != blank -%}
          <a href="{{ s.cta_url }}" class="btn btn--red btn--lg">{{ s.cta_text }}</a>
        {%- endif -%}
        {%- if s.note != blank -%}
          <span class="qteam__note">{{ s.note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Q Team directory",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "qteam", "info": "Used by in-page links and the section rail. Letters, numbers and dashes only." },
    { "type": "text", "id": "eyebrow_no", "label": "Eyebrow number", "default": "06" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Q Team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask for the chemist. You get the chemist." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "The Q Team page is a directory, not an About page — real names, real specialties, a real way to reach them. The single best asset an inside sales motion can have." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Meet the whole Q Team →" },
    { "type": "text", "id": "cta_url", "label": "Button link (URL or #anchor)", "default": "/pages/contact-rep" },
    { "type": "text", "id": "note", "label": "Note beside button", "default": "Placeholder names and photos — swap in the real directory.", "info": "Clear this once the real directory is in." }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Headshot (square)" },
        { "type": "text", "id": "image_alt", "label": "Headshot alt text", "info": "Defaults to the person's name." },
        { "type": "text", "id": "image_placeholder", "label": "Placeholder label (no image)", "default": "Headshot" },
        { "type": "text", "id": "role", "label": "Role", "default": "Formulation" },
        { "type": "text", "id": "name", "label": "Name", "default": "Chemist — name TBD" },
        { "type": "text", "id": "spec", "label": "Specialty", "default": "Custom blends, water chemistry, reformulation requests." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Q Team directory",
      "category": "Homepage",
      "blocks": [
        { "type": "person", "settings": { "role": "Formulation", "name": "Chemist — name TBD", "spec": "Custom blends, water chemistry, reformulation requests.", "image_placeholder": "Chemist headshot" } },
        { "type": "person", "settings": { "role": "Equipment & grants", "name": "Specialist — name TBD", "spec": "Machine specs, funding eligibility, application narratives.", "image_placeholder": "Equipment specialist headshot" } },
        { "type": "person", "settings": { "role": "Service", "name": "Lead tech — name TBD", "spec": "Mobile repair, preventive maintenance, install and calibration.", "image_placeholder": "Service tech headshot" } },
        { "type": "person", "settings": { "role": "Inside sales", "name": "Account manager — name TBD", "spec": "Programs, reorders, terms, training scheduling.", "image_placeholder": "Inside sales headshot" } }
      ]
    }
  ]
}
{% endschema %}
