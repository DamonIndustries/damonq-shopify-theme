{%- comment -%}
  Solutions row — 3-up curated bundle cards. Distinct from product cards:
  these represent multi-SKU bundles ("Meat Department Reset", "Red‑Kote
  Tank Restoration", etc.) that solve a specific job, not individual SKUs.

  Each solution is a block with style (red/ink/green header), eyebrow,
  title, pitch, included-items list, price, and CTA.
{%- endcomment -%}

<section class="solutions-row">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-head__title">{{ section.settings.heading }} <span class="section-head__title--accent">{{ section.settings.heading_accent }}</span></h2>
      </div>
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url }}" class="section-head__link">{{ section.settings.link_text }} →</a>
      {%- endif -%}
    </div>

    <div class="solutions-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'solution' -%}
          <article class="solution-card" {{ block.shopify_attributes }}>
            <header class="solution-card__top solution-card__top--{{ block.settings.color | default: 'red' }}">
              <span class="solution-card__eyebrow">{{ block.settings.eyebrow }}</span>
              <span class="solution-card__price-pill">{{ block.settings.price }}</span>
            </header>
            <div class="solution-card__body">
              <h3 class="solution-card__title">{{ block.settings.title }}</h3>
              <p class="solution-card__pitch">{{ block.settings.pitch }}</p>
              {%- if block.settings.included != blank -%}
                <ul class="solution-card__included">
                  {%- assign lines = block.settings.included | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- if line != blank -%}<li>{{ line | strip }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="solution-card__row">
                <span class="solution-card__price">{{ block.settings.price }}{% if block.settings.price_unit %}<small> {{ block.settings.price_unit }}</small>{% endif %}</span>
                <a href="{{ block.settings.url }}" class="solution-card__cta">{{ block.settings.cta | default: 'Shop bundle' }}</a>
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solutions row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cleaning solutions —" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (red)", "default": "ready-made bundles" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Browse all solutions" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "solution",
      "name": "Solution card",
      "limit": 3,
      "settings": [
        {
          "type": "select", "id": "color", "label": "Header color",
          "options": [
            { "value": "red", "label": "Damon red" },
            { "value": "ink", "label": "Ink (dark)" },
            { "value": "green", "label": "Green Seal" }
          ],
          "default": "red"
        },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Solution · Food Safety" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Meat Department Reset" },
        { "type": "textarea", "id": "pitch", "label": "Pitch", "default": "Da‑Clean A.P.C. enzyme cleaner, Q‑San no‑rinse food‑contact sanitizer, and the end‑of‑shift checklist USDA inspectors actually want to see." },
        { "type": "textarea", "id": "included", "label": "Included items (one per line)", "default": "Da‑Clean A.P.C. concentrate ×4\nQ‑San No‑Rinse sanitizer ×6\nWall dispenser ×2\nInspector‑ready checklist" },
        { "type": "text", "id": "price", "label": "Price", "default": "$118" },
        { "type": "text", "id": "price_unit", "label": "Price unit", "default": "/ bundle" },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Shop bundle" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Solutions row",
      "blocks": [
        {
          "type": "solution",
          "settings": {
            "color": "red",
            "eyebrow": "Solution · Food Safety",
            "title": "Meat Department Reset",
            "pitch": "Da‑Clean A.P.C. enzyme cleaner, Q‑San no‑rinse food‑contact sanitizer, and the end‑of‑shift checklist USDA inspectors actually want to see.",
            "included": "Da‑Clean A.P.C. ×4\nQ‑San No‑Rinse ×6\nWall dispenser ×2\nInspector checklist",
            "price": "$118",
            "price_unit": "/ bundle",
            "cta": "Shop bundle"
          }
        },
        {
          "type": "solution",
          "settings": {
            "color": "green",
            "eyebrow": "Solution · Schools",
            "title": "Healthy Schools Starter",
            "pitch": "Green Seal cleaners, microfiber, and a custodian training packet aligned with the Healthy Schools Campaign.",
            "included": "Green Seal cleaners ×6\nMicrofiber program ×2\nCustodian training packet\nIndoor air‑safe certified",
            "price": "$240",
            "price_unit": "/ starter",
            "cta": "Shop starter"
          }
        },
        {
          "type": "solution",
          "settings": {
            "color": "ink",
            "eyebrow": "Solution · Restoration",
            "title": "Red‑Kote Tank Kit",
            "pitch": "Restores leaking fuel tanks without removal. The 1940s formula chosen by independent garages and farm operators, still made in Ohio.",
            "included": "Red‑Kote tank liner\nTank prep solvent\nApplicator brushes\nApplication guide",
            "price": "$84.50",
            "price_unit": "/ kit",
            "cta": "Shop kit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
