<article class="container" style="padding: 56px 0; max-width: 760px;">
  <a href="{{ blog.url }}" style="font-size: 13px; color: var(--red); font-weight: 700;">← {{ blog.title }}</a>

  <header style="margin: 18px 0 32px;">
    <h1 style="font-size: clamp(36px, 4vw, 56px); margin: 0 0 12px; letter-spacing: -0.02em; line-height: 1.05; font-weight: 800;">{{ article.title }}</h1>
    <p style="color: var(--grey); font-size: 14px; margin: 0;">{{ article.published_at | date: '%B %-d, %Y' }} · {{ article.author }}</p>
  </header>

  {%- if article.image -%}
    {{ article.image | image_url: width: 1200 | image_tag: alt: article.title, style: 'border-radius: 18px; margin-bottom: 32px;' }}
  {%- endif -%}

  <div class="rte" style="font-size: 17px; line-height: 1.7;">
    {{ article.content }}
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
