      {%- for doc in documents -%}
        {%- assign doc_file = doc.file.value -%}
        {%- assign doc_href = '#' -%}
        {%- if doc_file and doc_file.url -%}{%- assign doc_href = doc_file.url -%}{%- endif -%}
        {%- assign doc_type_str = doc.doc_type.value | default: 'OTHER' -%}
        {%- case doc_type_str -%}
          {%- when 'SDS' -%}{%- assign doc_icon = 'SDS' -%}
          {%- when 'TDS' -%}{%- assign doc_icon = 'TDS' -%}
          {%- when 'EPA_LABEL' -%}{%- assign doc_icon = 'EPA' -%}
          {%- when 'PROTOCOL' -%}{%- assign doc_icon = 'QR' -%}
          {%- else -%}{%- assign doc_icon = 'DOC' -%}
        {%- endcase -%}
        <a href="{{ doc_href }}" target="_blank" rel="noopener" class="pdp-doc-row" style="background: var(--bg); padding: 14px; border-radius: 12px; margin: 8px 0;">
          <div class="pdp-doc-row__icon">{{ doc_icon }}</div>
          <div>
            <b>{{ doc.title.value | default: doc_type_str }}</b>
            {%- if doc.subtitle.value != blank -%}<p>{{ doc.subtitle.value }}</p>{%- endif -%}
