  {%- endif -%}
</section>

{%- comment -%} ============ Related products (Goes with) ============ {%- endcomment -%}
{%- if product.collections.first.products.size > 1 -%}
  <section class="pdp-related">
    <div class="container">
      <div class="pdp-related__head">
        <h2>Goes <span class="red">with</span></h2>
        <a href="{{ product.collections.first.url }}" class="pdp-related__link">Build a bundle →</a>
