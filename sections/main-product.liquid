              {%- if form_type != blank -%}
                <div class="row"><dt>Form</dt><dd>{{ form_type }}</dd></div>
              {%- endif -%}
              {%- if made_in != blank -%}
                <div class="row"><dt>Made in</dt><dd>{{ made_in }}</dd></div>
              {%- endif -%}
