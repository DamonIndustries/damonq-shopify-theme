          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<script>
(function () {
  // Gallery thumb → swap main image
  var mainImg = document.querySelector('.pdp__main img');
  document.querySelectorAll('.pdp__thumb[data-thumb-index]').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var src = thumb.getAttribute('data-thumb-img');
      if (!src || !mainImg) return;
      mainImg.src = src;
      mainImg.srcset = '';
      mainImg.alt = thumb.getAttribute('data-thumb-alt') || '';
      document.querySelectorAll('.pdp__thumb').forEach(function (t) { t.classList.remove('pdp__thumb--on'); });
      thumb.classList.add('pdp__thumb--on');
    });
  });

  // Tab switching
  document.querySelectorAll('[data-tab]').forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = tab.getAttribute('data-tab');
      document.querySelectorAll('.pdp-tab').forEach(function (t) { t.classList.remove('pdp-tab--on'); });
      tab.classList.add('pdp-tab--on');
      document.querySelectorAll('.pdp-panel').forEach(function (p) { p.classList.remove('pdp-panel--on'); });
      var panel = document.querySelector('[data-panel="' + target + '"]');
      if (panel) panel.classList.add('pdp-panel--on');
    });
  });

  // Track current variant price in cents — single source of truth for the
  // line total. `currentPriceBreaks` holds Shopify B2B volume price breaks
  // (array of {min, cents}); empty when the store isn't B2B or the customer
  // isn't on a catalog with volume pricing. Shopify's cart applies the
  // correct tiered price at checkout regardless — this state is only so
  // the Add-to-cart button preview matches what will actually charge.
  var currentPriceCents = {{ current_variant.price | default: 0 }};
  var currentPriceBreaks = [
    {%- for br in current_variant.quantity_price_breaks -%}
      {"min": {{ br.minimum_quantity }}, "cents": {{ br.price }}}{%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ];

  // Pick the applicable per-unit price cents for a given quantity. Walks
  // all breaks; the winning tier is the lowest price among those whose
  // minimum_quantity <= qty (which is normally the highest-min tier, but
  // we compare on price to be safe against weirdly-ordered rules).
  function priceCentsForQty(qty) {
    var best = currentPriceCents;
    for (var i = 0; i < currentPriceBreaks.length; i++) {
      var br = currentPriceBreaks[i];
      if (qty >= br.min && br.cents < best) best = br.cents;
    }
    return best;
  }

  function formatCents(c) {
    return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function getQty() {
    var qtyInput = document.querySelector('[data-qty-input]');
    var n = parseInt((qtyInput && qtyInput.value) || '1', 10);
    if (isNaN(n) || n < 1) n = 1;
    return n;
  }

  function updateLineTotal() {
    var lineTotal = document.querySelector('[data-line-total]');
    if (!lineTotal) return;
    var qty = getQty();
    lineTotal.textContent = formatCents(priceCentsForQty(qty) * qty);
  }

  // Re-render the Add-to-cart button to match the currently-selected
  // variant. Without this, picking an OOS variant leaves a clickable
  // "Add to cart" submit button that POSTs the OOS id to /cart/add.js.
  // Shopify would reject it server-side, but UX-wise we should never
  // even let the request fire.
  function syncBuyButton(v) {
    var btn = document.querySelector('[data-buy-btn]');
    if (!btn || !v) return;
    if (v.available) {
      btn.disabled = false;
      btn.removeAttribute('aria-disabled');
      btn.innerHTML = 'Add to cart · <span data-line-total>' + (v.price || '') + '</span>';
      // Re-compute line total against the just-rendered span
      updateLineTotal();
    } else {
      btn.disabled = true;
      btn.setAttribute('aria-disabled', 'true');
      btn.textContent = 'Sold out';
    }
  }

  // ---------- Multi-option variant picker ----------
  // Active when product has 2+ options (Size × Pack Quantity, etc.). Each
  // option group has its own row of buttons; selecting one combines with
  // selections from other groups to pick a variant.
  var picker = document.querySelector('[data-variant-picker]');
  if (picker) {
    var variantsJsonEl = picker.querySelector('[data-variants-json]');
    var variants = [];
    try { variants = JSON.parse(variantsJsonEl.textContent); } catch (e) { variants = []; }

    var groups = picker.querySelectorAll('.pdp__option-group');
    // Seed selectedOptions from whichever button is currently --on per group.
    var selectedOptions = [];
    groups.forEach(function (g) {
      var on = g.querySelector('.variant-tile--on');
      selectedOptions[parseInt(g.getAttribute('data-option-index'), 10)] = on ? on.getAttribute('data-option-value') : null;
    });

    function findVariantByOptions(opts) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var match = true;
        for (var j = 0; j < opts.length; j++) {
          if (v.options[j] !== opts[j]) { match = false; break; }
        }
        if (match) return v;
      }
      return null;
    }

    // Does ANY variant exist that matches `opts` only at the indices listed
    // in `fixedIdxs`? (Used to test partial combinations during auto-correct.)
    function variantExistsMatchingIdxs(opts, fixedIdxs) {
      return variants.some(function (v) {
        for (var i = 0; i < fixedIdxs.length; i++) {
          var idx = fixedIdxs[i];
          if (v.options[idx] !== opts[idx]) return false;
        }
        return true;
      });
    }

    // After a click sets `opts[changedIdx]`, walk every OTHER group and, if
    // the current value at that index would produce an impossible combo,
    // swap it for the first value that yields a valid (and ideally
    // available) variant. Always returns a `opts` array that maps to a real
    // variant — or the original `opts` if no variant exists at all.
    function autoCorrect(opts, changedIdx) {
      var fixed = [changedIdx];
      for (var i = 0; i < groups.length; i++) {
        if (i === changedIdx) continue;
        var fixedSoFar = fixed.slice();
        fixedSoFar.push(i);
        // If the current value at this index still works, keep it.
        if (variantExistsMatchingIdxs(opts, fixedSoFar)) {
          fixed.push(i);
          continue;
        }
        // Otherwise try every value in this group; prefer one with an
        // available matching variant, fall back to any existing variant.
        var group = groups[i];
        var buttons = group.querySelectorAll('[data-option-button]');
        var preferredValue = null;
        var fallbackValue = null;
        for (var b = 0; b < buttons.length; b++) {
          var candidate = buttons[b].getAttribute('data-option-value');
          var testOpts = opts.slice();
          testOpts[i] = candidate;
          var testFixed = fixed.slice();
          testFixed.push(i);
          var hasVariant = variantExistsMatchingIdxs(testOpts, testFixed);
          if (!hasVariant) continue;
          if (!fallbackValue) fallbackValue = candidate;
          // Prefer an in-stock match
          var match = findVariantByOptions(testOpts);
          if (match && match.available) { preferredValue = candidate; break; }
        }
        var chosen = preferredValue || fallbackValue;
        if (chosen) {
          opts[i] = chosen;
          fixed.push(i);
        }
      }
      return opts;
    }

    // Update visible state of every group: active button per group + the
    // selected-value text in the label. Used after auto-correct so the UI
    // reflects swaps the user didn't explicitly make.
    function syncGroupsToSelection() {
      groups.forEach(function (g) {
        var idx = parseInt(g.getAttribute('data-option-index'), 10);
        var current = selectedOptions[idx];
        g.querySelectorAll('[data-option-button]').forEach(function (b) {
          b.classList.toggle('variant-tile--on', b.getAttribute('data-option-value') === current);
        });
        var label = g.querySelector('[data-selected-option-value]');
        if (label && current != null) label.textContent = current;
      });
    }

    // Mark a button dimmed when combining its value with the OTHER groups'
    // current selections produces no variant at all (impossible combo —
    // e.g. "55 gal / 4-pack" when only Single exists at that size).
    //
    // We deliberately do NOT dim a button just because its matching variant
    // is sold out (variant exists, inventory = 0) — that's already conveyed
    // by the Add-to-cart button + ship-row stock pill, and dimming here
    // would falsely suggest the value itself is unreachable.
    function refreshAvailability() {
      groups.forEach(function (g) {
        var idx = parseInt(g.getAttribute('data-option-index'), 10);
        g.querySelectorAll('[data-option-button]').forEach(function (btn) {
          var testOpts = selectedOptions.slice();
          testOpts[idx] = btn.getAttribute('data-option-value');
          var combinedExists = !!findVariantByOptions(testOpts);
          btn.classList.toggle('variant-tile--oos', !combinedExists);
        });
      });
    }

    function applyVariant(v) {
      if (!v) return;
      // Hidden form input
      var input = document.querySelector('[data-variant-id-input]');
      if (input) input.value = String(v.id);

      // Buy button — must reflect the NEW variant's availability. Without
      // this, switching to an OOS variant leaves a clickable "Add to cart"
      // that POSTs the OOS id to /cart/add.js (Shopify will reject, but
      // we shouldn't even let the request happen).
      syncBuyButton(v);

      // Price block
      var priceEl = document.querySelector('[data-price]');
      if (priceEl && v.price) {
        var unitHtml = v.container_type
          ? '<small> / ' + v.container_type.toLowerCase() + '</small>'
          : '';
        priceEl.innerHTML = v.price + unitHtml;
      }

      // Line total (qty × variant with volume-break lookup)
      if (typeof v.price_cents === 'number' && v.price_cents > 0) {
        currentPriceCents = v.price_cents;
      }
      currentPriceBreaks = Array.isArray(v.quantity_price_breaks) ? v.quantity_price_breaks : [];
      updateLineTotal();

      // Stock pill in ship-row
      var stockTextEl = document.querySelector('[data-stock-text]');
      var stockIconEl = document.querySelector('[data-stock-icon]');
      var stockColor = v.available ? 'good' : 'bad';
      var stockText  = v.available ? 'Available · ships today' : 'Out of stock';
      if (stockTextEl) stockTextEl.textContent = stockText;
      if (stockIconEl) {
        stockIconEl.classList.remove('pdp__ship-icon--good', 'pdp__ship-icon--warn', 'pdp__ship-icon--bad');
        stockIconEl.classList.add('pdp__ship-icon--' + stockColor);
      }

      // Main image
      if (mainImg && v.image) {
        mainImg.src = v.image;
        mainImg.srcset = '';
        mainImg.alt = v.image_alt || '';
        document.querySelectorAll('.pdp__thumb').forEach(function (t) { t.classList.remove('pdp__thumb--on'); });
        if (v.image_id) {
          var matchThumb = document.querySelector('.pdp__thumb[data-thumb-image-id="' + v.image_id + '"]');
          if (matchThumb) matchThumb.classList.add('pdp__thumb--on');
        }
      }

      // URL ?variant=
      var url = new URL(window.location.href);
      url.searchParams.set('variant', String(v.id));
      window.history.replaceState({}, '', url);
    }

    picker.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-option-button]');
      if (!btn || !picker.contains(btn)) return;
      var idx = parseInt(btn.getAttribute('data-option-index'), 10);
      var value = btn.getAttribute('data-option-value');

      // Tentatively set the clicked value; then auto-correct other groups
      // if the resulting combo doesn't map to a real variant.
      selectedOptions[idx] = value;
      selectedOptions = autoCorrect(selectedOptions, idx);

      // Re-sync all groups (the clicked one and any auto-corrected ones)
      syncGroupsToSelection();

      var v = findVariantByOptions(selectedOptions);
      applyVariant(v);
      refreshAvailability();
    });

    // First paint — disable any unavailable values given the seeded selection.
    refreshAvailability();
  }

  // ---------- Single-option rich tile picker (1 option only) ----------
  document.querySelectorAll('[data-variant-tile]').forEach(function (tile) {
    tile.addEventListener('click', function () {
      // Active state on tiles
      document.querySelectorAll('[data-variant-tile]').forEach(function (t) { t.classList.remove('variant-tile--on'); });
      tile.classList.add('variant-tile--on');

      var variantId = tile.getAttribute('data-variant-tile');
      var input = document.querySelector('[data-variant-id-input]');
      if (input) input.value = variantId;

      // Update the "selected" name in the label
      var nameEl = document.querySelector('[data-selected-variant-name]');
      var newName = tile.getAttribute('data-variant-name');
      if (nameEl && newName) nameEl.textContent = newName;

      // Update price block (per-unit price, no qty multiplier here)
      var priceEl = document.querySelector('[data-price]');
      var newPrice = tile.getAttribute('data-variant-price');
      var newType = tile.getAttribute('data-variant-container-type');
      if (priceEl && newPrice) {
        var unitHtml = newType
          ? '<small> / ' + newType.toLowerCase() + '</small>'
          : '';
        priceEl.innerHTML = newPrice + unitHtml;
      }

      // Update tracked variant price + recompute Add-to-cart line total
      var newPriceCents = parseInt(tile.getAttribute('data-variant-price-cents') || '0', 10);
      if (!isNaN(newPriceCents) && newPriceCents > 0) {
        currentPriceCents = newPriceCents;
      }
      try {
        currentPriceBreaks = JSON.parse(tile.getAttribute('data-variant-breaks') || '[]');
      } catch (e) {
        currentPriceBreaks = [];
      }

      // Sync the buy button to the newly selected variant's availability
      // BEFORE updateLineTotal, since syncBuyButton may re-render the
      // [data-line-total] span that updateLineTotal writes into.
      syncBuyButton({
        available: tile.getAttribute('data-variant-available') === 'true',
        price: tile.getAttribute('data-variant-price')
      });
      updateLineTotal();

      // Sync ship-row stock tile to the newly selected variant
      var stockText  = tile.getAttribute('data-stock-long');
      var stockColor = tile.getAttribute('data-stock-color');
      var stockTextEl = document.querySelector('[data-stock-text]');
      var stockIconEl = document.querySelector('[data-stock-icon]');
      if (stockTextEl && stockText) stockTextEl.textContent = stockText;
      if (stockIconEl && stockColor) {
        stockIconEl.classList.remove('pdp__ship-icon--good', 'pdp__ship-icon--warn', 'pdp__ship-icon--bad');
        stockIconEl.classList.add('pdp__ship-icon--' + stockColor);
      }

      // Swap main image if variant has one
      var newImg = tile.getAttribute('data-variant-image');
      var newImgId = tile.getAttribute('data-variant-image-id');
      if (mainImg && newImg) {
        mainImg.src = newImg;
        mainImg.srcset = '';
        mainImg.alt = tile.getAttribute('data-variant-image-alt') || '';
        // Highlight matching thumb if the variant image is one of them
        document.querySelectorAll('.pdp__thumb').forEach(function (t) { t.classList.remove('pdp__thumb--on'); });
        if (newImgId) {
          var matchThumb = document.querySelector('.pdp__thumb[data-thumb-image-id="' + newImgId + '"]');
          if (matchThumb) matchThumb.classList.add('pdp__thumb--on');
        }
      }

      // Update the URL without reload so refresh keeps the choice
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', url);
    });
  });

  // Quantity stepper — every change re-computes line total
  var qtyInput = document.querySelector('[data-qty-input]');
  if (qtyInput) {
    var minus = document.querySelector('[data-qty-minus]');
    var plus = document.querySelector('[data-qty-plus]');
    if (minus) minus.addEventListener('click', function () {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || '1', 10) - 1);
      updateLineTotal();
    });
    if (plus) plus.addEventListener('click', function () {
      qtyInput.value = parseInt(qtyInput.value || '1', 10) + 1;
      updateLineTotal();
    });
    qtyInput.addEventListener('input', updateLineTotal);
    qtyInput.addEventListener('change', function () {
      // Clamp to min 1 if user types 0 or negative
      var n = parseInt(qtyInput.value || '1', 10);
      if (isNaN(n) || n < 1) qtyInput.value = 1;
      updateLineTotal();
    });
  }

  // Initial paint — covers the case where qty starts > 1 from a refresh
  updateLineTotal();
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "AutoStock subscribe-and-save" },
    {
      "type": "checkbox",
      "id": "show_autostock",
      "label": "Show AutoStock toggle on this page",
      "default": true,
      "info": "When on, shows the Subscribe & save AutoStock cadence picker above the Add to cart button. Turn off for products that are not eligible for the recurring program (samples, one-off SKUs, bulk drums, etc.)."
    },
    { "type": "header", "content": "Save to a bundle" },
    {
      "type": "checkbox",
      "id": "show_save_bundle",
      "label": "Show Save to a bundle button",
      "default": true,
      "info": "Shows the secondary 'Save to a bundle' button below Add to cart. Turn off for products that don't make sense to bundle (drums, services, one-off items)."
    },
    { "type": "header", "content": "Bulk order link" },
    {
      "type": "checkbox",
      "id": "show_bulk_order_link",
      "label": "Show Bulk order link",
      "default": false,
      "info": "Shows the 'Bulk order' link in the B2B link group on the PDP. Hidden by default — turn on once the bulk order tool is in place."
    },
    { "type": "header", "content": "Locksmith access control" },
    {
      "type": "paragraph",
      "content": "Wraps the Add-to-cart button so customers without access see a 'Request access' link instead. Requires the Locksmith Shopify app — in each lock you want to gate, open Advanced → tick 'Enable manual locking'. Leave this off until Locksmith is installed and locks are configured."
    },
    {
      "type": "checkbox",
      "id": "locksmith_enabled",
      "label": "Enable Locksmith manual mode on Add to cart",
      "default": false,
      "info": "When on, calls Locksmith's locksmith-variables snippet to check access. Fail-secure: if the snippet is missing, errors, or returns anything other than 'true', the product stays locked. When this toggle is off, Add to cart always renders normally."
    },
    {
      "type": "checkbox",
      "id": "locksmith_preview_locked",
      "label": "Preview as locked (theme editor only)",
      "default": false,
      "info": "Forces the locked UI in the Shopify theme editor preview so you can style and verify the Request access state. Has no effect on the live storefront — Shopify's request.design_mode gates this off in production. Locksmith normally grants admin/staff users access, which is why the editor preview otherwise looks unlocked."
    },
    {
      "type": "text",
      "id": "locksmith_button_label",
      "label": "Request access button label",
      "default": "Request access to purchase",
      "info": "Shown in place of Add to cart when the visitor does not have access."
    },
    {
      "type": "text",
      "id": "locksmith_button_icon",
      "label": "Request access button icon",
      "default": "🔒",
      "info": "Small prefix shown before the label. Leave blank for no icon."
    },
    {
      "type": "textarea",
      "id": "locksmith_note",
      "label": "Request access note",
      "default": "This product requires approval before purchase.",
      "info": "Short explanation shown below the Request access button. The rep link label from Theme settings → Contact is appended automatically."
    }
  ]
}
{% endschema %}
