              {%- assign doc_href = '#' -%}
              {%- if doc_file and doc_file.url -%}{%- assign doc_href = doc_file.url -%}{%- endif -%}
              {%- assign doc_type_str = doc.doc_type.value | default: 'OTHER' -%}
