              {%- when 'caution' -%}
                <div class="surf surf--caution"><span class="surf__caution">!</span><div>{{ f.surface_name.value }}{% if f.note.value != blank %}<span class="surf__note">{{ f.note.value }}</span>{% endif %}</div></div>
              {%- else -%}
                <div class="surf surf--no"><span class="surf__no">!</span><div>{{ f.surface_name.value }}{% if f.note.value != blank %}<span class="surf__note">{{ f.note.value }}</span>{% endif %}</div></div>
