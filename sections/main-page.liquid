<article class="container" style="padding: 56px 0; max-width: 760px;">
  <header style="margin-bottom: 32px;">
    <h1 style="font-size: clamp(36px, 4vw, 56px); margin: 0; letter-spacing: -0.02em; line-height: 1.05; font-weight: 800;">{{ page.title }}</h1>
  </header>
  <div class="rte" style="font-size: 17px; line-height: 1.7;">
    {{ page.content }}
  </div>
</article>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
