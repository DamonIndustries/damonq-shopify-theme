<section class="section-row" style="padding: 28px 0 0;">
  <div class="container">
    <div class="trust-strip" role="region" aria-label="Trust signals">
      {%- for block in section.blocks -%}
        <div class="trust-strip__item" {{ block.shopify_attributes }}>
          <span class="trust-strip__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <div>
            <b>{{ block.settings.title }}</b>
            <span>{{ block.settings.body }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "settings": [],
  "blocks": [
    {
      "type": "cell",
      "name": "Trust cell",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "⛟" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ships from Ohio" },
        { "type": "text", "id": "body", "label": "Body", "default": "Same‑day before 2pm ET" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "cell", "settings": { "icon": "⛟", "title": "Ships from Ohio", "body": "Same‑day before 2pm ET" } },
        { "type": "cell", "settings": { "icon": "⏎", "title": "30‑day returns", "body": "Even on opened cases" } },
        { "type": "cell", "settings": { "icon": "★", "title": "4.9 / 5 average", "body": "Across 2,400+ facility reviews" } },
        { "type": "cell", "settings": { "icon": "$", "title": "Net‑30 financing", "body": "For verified facilities" } }
      ]
    }
  ]
}
{% endschema %}
