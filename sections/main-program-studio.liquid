{%- comment -%} =================== Pre-rendered product map for the recommender =================== {%- endcomment -%}
{%- capture handle_map -%}
{
  {%- assign comma = '' -%}
  {%- for product in collections.all.products limit: 250 -%}
    {{ comma }}{{ product.handle | json }}:{
      "id":{{ product.selected_or_first_available_variant.id }},
      "title":{{ product.title | json }},
      "url":{{ product.url | json }},
      "price":{{ product.selected_or_first_available_variant.price }},
      "priceFormatted":{{ product.selected_or_first_available_variant.price | money | json }},
      "image":{{ product.featured_image | image_url: width: 96 | json }}
    }
    {%- assign comma = ',' -%}
  {%- endfor -%}
}
{%- endcapture -%}
<script type="application/json" data-studio-products>{{ handle_map }}</script>

