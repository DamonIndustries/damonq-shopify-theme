  };

  var SIZE_LABELS = ['Small (1 site)', 'Small/mid', 'Mid-size', 'Large', 'Multi-site / 100k+ sqft'];
  var SIZE_SCALE  = [0.4,             0.7,           1.0,         1.5,     2.4];

  // ============= STATE =============
  var state = {
    step: 1,
    industry: null,
    size: 3,           // 1..5 index → SIZE_LABELS / SIZE_SCALE
    budget: 1200,      // dollars/month
    compliance: [],
    special: [],
    notes: ''
  };

  var productMap = {};
  try { productMap = JSON.parse(document.querySelector('[data-studio-products]').textContent); } catch (e) {}

  // ============= HELPERS =============
  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function escapeHtml(s) { return String(s || '').replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function moneyCents(c) { return '$' + (c / 100).toFixed(c % 100 === 0 ? 0 : 2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
  function moneyDollars(d) { return '$' + Math.round(d).toLocaleString(); }

  // ============= RECOMMENDER =============
  function buildProgram() {
    if (!state.industry) return null;
    var arch = ARCHETYPES[state.industry];
    if (!arch) return null;

    var scale = SIZE_SCALE[state.size - 1] || 1;
    var sizeLabel = SIZE_LABELS[state.size - 1] || 'Mid-size';
    var insights = [];
    var products = arch.products.map(function (p) {
      var resolved = productMap[p.handle] || null;
      return {
        handle: p.handle,
        qty: Math.max(1, Math.round(p.qty * scale)),
        label: p.label,
        title: resolved ? resolved.title : p.fallback.name,
        url: resolved ? resolved.url : '#',
        priceEach: resolved ? resolved.price : p.fallback.priceEach,
        image: resolved ? resolved.image : null,
        thumb: p.fallback.thumb,
        thumbSmall: p.fallback.thumbSmall,
        thumbColor: p.fallback.thumbColor || 'red',
        variantId: resolved ? resolved.id : null,
        added: true
      };
    });

    // Compliance adjustments — append USDA-friendly Q-San if not in list
    if (state.compliance.indexOf('usda') >= 0) {
      var hasQSan = products.some(function (p) { return /q-san/i.test(p.title) || p.handle.indexOf('q-san') === 0; });
      if (!hasQSan) {
        var qsan = productMap['q-san-no-rinse-sanitizer'];
        products.push({
          handle: 'q-san-no-rinse-sanitizer',
          qty: Math.max(2, Math.round(3 * scale)),
          label: 'cases / mo',
          title: qsan ? qsan.title : 'Q-San No-Rinse',
          url: qsan ? qsan.url : '#',
          priceEach: qsan ? qsan.price : 3150,
          image: qsan ? qsan.image : null,
          thumb: 'Q-SAN', thumbSmall: 'NO RINSE', thumbColor: 'green',
          variantId: qsan ? qsan.id : null,
          added: true
        });
      }
      insights.push({ b: 'USDA selected', body: " — locked Q-San in for daily food-contact sanitization, no-rinse approved." });
    }
    if (state.compliance.indexOf('green-seal') >= 0) {
      insights.push({ b: 'Green Seal selected', body: " — chemistry has been swapped to neutral concentrates where available." });
    }
    if (state.compliance.indexOf('cms-jc') >= 0 && state.industry === 'healthcare-ppd') {
      insights.push({ b: 'CMS / Joint Commission', body: " — your program ships with a sub-minute SARS-CoV-2 disinfectant and a one-step EPA claim." });
    }

    // Special-considerations adjustments
    if (state.special.indexOf('night-shift') >= 0) {
      // Swap any RTU floor cleaner to concentrate (if both exist in catalog)
      // For MVP just emit insight
      var savings = Math.round(487 * scale);
      insights.push({ b: 'Night-shift = concentrate', body: ' — pre-mixing at shift start saves <b>~$' + savings.toLocaleString() + '/yr</b> vs. RTU floor cleaner.' });
    }
    if (state.special.indexOf('food-service') >= 0 && state.industry === 'healthcare-ppd') {
      insights.push({ b: 'Food service add-on', body: ' — added Q-San rotation for cafeteria and pantry food-contact surfaces.' });
    }
    if (state.special.indexOf('pediatric') >= 0) {
      insights.push({ b: 'Pediatric / sensitive', body: ' — chemistry has been rotated to lower-fume formulations where available.' });
    }
    if (state.special.indexOf('robotic') >= 0) {
      insights.push({ b: 'Robotic scrubber compatible', body: ' — concentrates spec\'d match the dilution range Brain Corp / Whiz fleets accept.' });
    }
    if (state.special.indexOf('training') >= 0) {
      arch.extras = arch.extras || [];
      var hasTraining = arch.extras.some(function (e) { return /training/i.test(e.name); });
      if (!hasTraining) {
        arch.extras.unshift({ name: 'Crew Training Pack', desc: 'QR-coded SDS &amp; protocol video', priceLabel: 'Included', oneTime: true, thumb: 'QR VIDEO', thumbSmall: 'TRNG', thumbColor: 'dark' });
      }
    }

    // Compute monthly cost
    var monthly = products.reduce(function (sum, p) { return sum + (p.priceEach * p.qty); }, 0);

    // Cap to budget if too high (just clamp top product qty)
    var budgetCents = state.budget * 100;
    if (monthly > budgetCents * 1.15 && products.length > 0) {
      // Reduce highest-cost product proportionally
      var ratio = budgetCents / monthly;
      products.forEach(function (p) {
        p.qty = Math.max(1, Math.round(p.qty * ratio));
      });
      monthly = products.reduce(function (sum, p) { return sum + (p.priceEach * p.qty); }, 0);
      insights.push({ b: 'Budget-aware', body: ' — quantities trimmed to fit your <b>' + moneyDollars(state.budget) + '/mo</b> target.' });
    }

    var pct = 18; // typical Damon savings claim — fixed for MVP
    if (state.special.indexOf('night-shift') >= 0) pct += 3;
    if (state.compliance.indexOf('green-seal') >= 0) pct += 2;
    var annualSavings = Math.round((monthly * 12) * pct / (100 - pct));

    return {
      industry: state.industry,
      archetype: arch,
      sizeLabel: sizeLabel,
      shifts: state.special.indexOf('night-shift') >= 0 ? '24/7 / night shift' : 'Day shifts',
      products: products,
      extras: arch.extras || [],
      monthlyCents: monthly,
      annualSavingsCents: annualSavings,
      savingsPct: pct,
      insights: insights,
      summaryText: arch.descTpl({ sizeLabel: sizeLabel, shifts: state.special.indexOf('night-shift') >= 0 ? '24/7 ops' : 'day shifts' })
    };
  }

  // ============= RENDER =============
  function renderStepper() {
    $$('[data-step-pill]').forEach(function (pill) {
      var n = parseInt(pill.getAttribute('data-step-pill'), 10);
      pill.classList.remove('is-active', 'is-done');
      if (n === state.step) pill.classList.add('is-active');
      else if (n < state.step) pill.classList.add('is-done');
      var dot = pill.querySelector('.studio-step-pill__dot');
      if (dot) dot.textContent = n < state.step ? '✓' : (n === 5 ? '★' : String(n));
    });

    $$('.studio-screen').forEach(function (s) {
      s.classList.toggle('is-active', parseInt(s.getAttribute('data-screen'), 10) === state.step);
    });

    var back = $('[data-step-back]');
    var next = $('[data-step-next]');
    if (back) back.disabled = state.step === 1;
    if (next) {
      if (state.step === 5) { next.textContent = 'Restart with new inputs ↻'; }
      else if (state.step === 4) { next.textContent = 'Build my program ✦'; }
      else { next.textContent = 'Continue · build program ✦'; }
    }
  }

  function renderInputs() {
    // Industry
    $$('[data-input="industry"]').forEach(function (b) {
      b.classList.toggle('is-on', b.getAttribute('data-value') === state.industry);
    });
    // Size slider — set fill var
    var sizeIn = $('[data-input="size"]');
    if (sizeIn) {
      sizeIn.value = state.size;
      sizeIn.style.setProperty('--studio-slider-pct', ((state.size - 1) / 4 * 100) + '%');
    }
    var sizeDisp = $('[data-size-display]');
    if (sizeDisp) sizeDisp.textContent = SIZE_LABELS[state.size - 1] || 'Mid-size';
    // Budget slider
    var budIn = $('[data-input="budget"]');
    if (budIn) {
      budIn.value = state.budget;
      var pct = (state.budget - 200) / (5000 - 200) * 100;
      budIn.style.setProperty('--studio-slider-pct', pct + '%');
    }
    var budDisp = $('[data-budget-display]');
    if (budDisp) budDisp.textContent = moneyDollars(state.budget) + '/mo';
    // Compliance
    $$('[data-input="compliance"]').forEach(function (b) {
      b.classList.toggle('is-on', state.compliance.indexOf(b.getAttribute('data-value')) >= 0);
    });
    // Special
    $$('[data-input="special"]').forEach(function (b) {
      b.classList.toggle('is-on', state.special.indexOf(b.getAttribute('data-value')) >= 0);
    });
    // Notes
    var notes = $('[data-input="notes"]');
    if (notes) notes.value = state.notes;
    // Step 5 summary text
    var summary = $('[data-summary-text]');
    if (summary) {
      var program = buildProgram();
      summary.textContent = program ? program.summaryText : '—';
    }
  }

  function renderPreview() {
    var program = buildProgram();
    var emptyEl = $('[data-preview-empty]');
    var builtEl = $('[data-preview-built]');
    if (!program) {
      if (emptyEl) emptyEl.style.display = '';
      if (builtEl) builtEl.hidden = true;
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';
    if (builtEl) builtEl.hidden = false;

    // Title + desc
    var titleEl = $('[data-program-title]');
    if (titleEl) titleEl.innerHTML = escapeHtml(program.archetype.name) + (program.archetype.titleAccent ? ' <span class="red">+ ' + escapeHtml(program.archetype.titleAccent) + '</span>' : '');
    var descEl = $('[data-program-desc]');
    if (descEl) descEl.textContent = program.summaryText;

    // Insights
    var insightsEl = $('[data-program-insights]');
    if (insightsEl) {
      if (program.insights.length === 0) {
        insightsEl.innerHTML = '';
      } else {
        insightsEl.innerHTML = program.insights.map(function (i) {
          return '<div class="studio-insight"><span class="studio-insight__icon">✦</span><p><b>' + i.b + '</b>' + i.body + '</p></div>';
        }).join('');
      }
    }

    // Product grid
    var gridEl = $('[data-program-grid]');
    if (gridEl) {
      var html = '';
      program.products.forEach(function (p) {
        var img = p.image
          ? '<div class="studio-pcell__thumb"><img src="' + p.image + '" alt=""></div>'
          : '<div class="studio-pcell__thumb-fallback ' + (p.thumbColor === 'green' ? 'green' : (p.thumbColor === 'dark' ? 'dark' : '')) + '" style="' + (p.thumbColor === 'green' ? 'background: var(--good);' : p.thumbColor === 'dark' ? 'background: var(--ink);' : '') + '"><small>' + (p.thumbSmall || '') + '</small>' + (p.thumb || '') + '</div>';
        html += '<div class="studio-pcell is-added">'
              +   img
              +   '<div class="studio-pcell__info">'
              +     '<h4>' + escapeHtml(p.title) + '</h4>'
              +     '<p>' + escapeHtml(p.label) + '</p>'
              +     '<div class="studio-pcell__qp"><span>×' + p.qty + ' ' + escapeHtml(p.label) + '</span><span class="price">' + moneyCents(p.priceEach * p.qty) + '</span></div>'
              +   '</div>'
              + '</div>';
      });
      program.extras.forEach(function (x) {
        html += '<div class="studio-pcell">'
              +   '<div class="studio-pcell__thumb-fallback ' + (x.thumbColor === 'dark' ? 'dark' : '') + '" style="' + (x.thumbColor === 'dark' ? 'background: var(--ink);' : '') + '"><small>' + (x.thumbSmall || '') + '</small>' + (x.thumb || '') + '</div>'
              +   '<div class="studio-pcell__info">'
              +     '<h4>' + escapeHtml(x.name) + '</h4>'
              +     '<p>' + x.desc + '</p>'
              +     '<div class="studio-pcell__qp"><span>' + (x.oneTime ? 'One-time' : '') + '</span><span class="price">' + escapeHtml(x.priceLabel || '$0') + '</span></div>'
              +   '</div>'
              + '</div>';
      });
      gridEl.innerHTML = html;
    }

    // ROI
    var monthEl = $('[data-roi-monthly]');     if (monthEl) monthEl.textContent = moneyCents(program.monthlyCents);
    var pctEl   = $('[data-roi-pct]');         if (pctEl)   pctEl.textContent = '−' + program.savingsPct + '%';
    var annEl   = $('[data-roi-annual]');      if (annEl)   annEl.textContent = moneyCents(program.annualSavingsCents);
    var totalEl = $('[data-program-total]');   if (totalEl) totalEl.textContent = moneyCents(program.monthlyCents) + ' / month';
    // Disable checkout if no resolved products
    var checkoutBtn = $('[data-program-checkout]');
    if (checkoutBtn) {
      var resolvable = program.products.filter(function (p) { return p.variantId; });
      checkoutBtn.disabled = resolvable.length === 0;
      if (resolvable.length === 0) {
        checkoutBtn.textContent = 'Talk to a rep — products not yet listed';
      } else {
        checkoutBtn.textContent = 'Activate AutoStock & add to cart →';
      }
    }
  }

  function rerender() {
    renderStepper();
    renderInputs();
    renderPreview();
  }

  // ============= INTERACTIONS =============

  // Buttons & checks
  document.addEventListener('click', function (e) {
    // Single-select industry
    var indBtn = e.target.closest('[data-input="industry"]');
    if (indBtn) {
      state.industry = indBtn.getAttribute('data-value');
      rerender();
      return;
    }
    // Multi-select compliance / special
    var multi = e.target.closest('[data-input="compliance"], [data-input="special"]');
    if (multi) {
      var key = multi.getAttribute('data-input');
      var val = multi.getAttribute('data-value');
      var arr = state[key];
      var idx = arr.indexOf(val);
      if (idx >= 0) arr.splice(idx, 1); else arr.push(val);
      rerender();
      return;
    }
    // Prompt chip
    var chip = e.target.closest('[data-prompt-add]');
    if (chip) {
      var ta = $('[data-input="notes"]');
      if (ta) {
        var prefix = chip.getAttribute('data-prompt-add');
        if (ta.value) ta.value += '\n';
        ta.value += prefix;
        ta.focus();
        state.notes = ta.value;
      }
      return;
    }
    // Step nav
    if (e.target.closest('[data-step-next]')) {
      // Validate step
      if (state.step === 1 && !state.industry) {
        if (window.DamonToast) window.DamonToast('Pick an industry to continue', { variant: 'info' });
        return;
      }
      if (state.step === 5) {
        // Restart
        state = { step: 1, industry: null, size: 3, budget: 1200, compliance: [], special: [], notes: '' };
        rerender();
        return;
      }
      state.step = Math.min(5, state.step + 1);
      rerender();
      return;
    }
    if (e.target.closest('[data-step-back]')) {
      state.step = Math.max(1, state.step - 1);
      rerender();
      return;
    }
    // Step pill click → jump to step (only allowed for done steps + next)
    var pill = e.target.closest('[data-step-pill]');
    if (pill) {
      var n = parseInt(pill.getAttribute('data-step-pill'), 10);
      if (n <= state.step + 1) { state.step = n; rerender(); }
      return;
    }
    // Save program
    if (e.target.closest('[data-program-save]')) {
      var program = buildProgram();
      if (!program) return;
      try {
        var saved = JSON.parse(localStorage.getItem('damon-saved-programs') || '[]');
        saved.unshift({
          ts: Date.now(),
          name: program.archetype.name + ' · ' + program.sizeLabel,
          state: state,
          monthly: program.monthlyCents
        });
        if (saved.length > 12) saved.length = 12;
        localStorage.setItem('damon-saved-programs', JSON.stringify(saved));
        if (window.DamonToast) window.DamonToast('Program saved to this device', { sub: program.archetype.name });
      } catch (err) {
        if (window.DamonToast) window.DamonToast('Could not save program', { variant: 'error' });
      }
      return;
    }
    // PDF export
    if (e.target.closest('[data-program-pdf]')) {
      window.print();
      return;
    }
    // Checkout — bulk add to cart
    var checkBtn = e.target.closest('[data-program-checkout]');
    if (checkBtn && !checkBtn.disabled) {
      var program = buildProgram();
      if (!program) return;
      var items = program.products
        .filter(function (p) { return p.variantId; })
        .map(function (p) {
          return {
            id: p.variantId,
            quantity: p.qty,
            properties: { '_program': program.archetype.name, '_autostock_cadence': '4_weeks' }
          };
        });
      if (!items.length) return;
      checkBtn.disabled = true;
      var orig = checkBtn.textContent;
      checkBtn.textContent = 'Adding…';
      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { if (!r.ok) throw new Error('add-failed'); return r.json(); })
        .then(function () {
          if (window.DamonToast) {
            window.DamonToast(items.length + ' items added · AutoStock activated', {
              sub: program.archetype.name,
              action: { label: 'View cart', onClick: function () { document.dispatchEvent(new CustomEvent('cart:open')); } }
            });
          }
          checkBtn.textContent = orig;
          checkBtn.disabled = false;
        })
        .catch(function () {
          if (window.DamonToast) window.DamonToast('Could not add some items', { variant: 'error' });
          checkBtn.textContent = orig;
          checkBtn.disabled = false;
        });
      return;
    }
    // Clone & tweak from recents gallery
    var clone = e.target.closest('[data-clone-program]');
    if (clone) {
      e.preventDefault();
      state = {
        step: 5,
        industry: clone.getAttribute('data-clone-industry'),
        size: parseInt(clone.getAttribute('data-clone-size') || '3', 10),
        budget: 1200,
        compliance: [],
        special: [],
        notes: 'Cloned from a recent example.'
      };
      rerender();
      var page = document.querySelector('.studio-page');
      if (page) page.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
  });

  // Slider inputs
  document.addEventListener('input', function (e) {
    if (e.target.matches('[data-input="size"]')) {
      state.size = parseInt(e.target.value, 10);
      rerender();
    } else if (e.target.matches('[data-input="budget"]')) {
      state.budget = parseInt(e.target.value, 10);
      rerender();
    } else if (e.target.matches('[data-input="notes"]')) {
      state.notes = e.target.value;
    }
  });

  // Initial paint
  rerender();
})();
</script>

{% schema %}
{ "name": "Program Studio", "settings": [] }
{% endschema %}
