{%- comment -%}
  Catalog strip — quiet commerce strip near the bottom of the homepage:
  "The full catalog is still one click away." Eyebrow, title, description
  and two CTAs (browse / sign in to reorder).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign anchor = s.anchor_id | default: 'shop'
-%}

<section class="catalog-strip" id="{{ anchor }}">
  <div class="container">
    <div class="catalog-strip__in">
      <div class="catalog-strip__copy">
        {%- if s.eyebrow != blank -%}<div class="catalog-strip__eye">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 class="catalog-strip__title">{{ s.heading }}</h2>
        {%- if s.description != blank -%}<p class="catalog-strip__desc">{{ s.description }}</p>{%- endif -%}
      </div>
      {%- if s.cta_primary_text != blank or s.cta_secondary_text != blank -%}
        <div class="catalog-strip__ctas">
          {%- if s.cta_primary_text != blank -%}
            <a href="{{ s.cta_primary_url }}" class="btn btn--ink btn--lg">{{ s.cta_primary_text }}</a>
          {%- endif -%}
          {%- if s.cta_secondary_text != blank -%}
            <a href="{{ s.cta_secondary_url }}" class="btn btn--outline btn--lg">{{ s.cta_secondary_text }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catalog strip",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "shop", "info": "Used by in-page links and the section rail. Letters, numbers and dashes only." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Already know what you need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The full catalog is still one click away." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "300+ formulas, quart through 220‑gallon tote, Net‑30 for verified facilities, reorder from your history. Ships from Alliance, Ohio." },
    { "type": "text", "id": "cta_primary_text", "label": "Primary button", "default": "Browse the catalog →" },
    { "type": "text", "id": "cta_primary_url", "label": "Primary link (URL or #anchor)", "default": "/collections/all" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary button", "default": "Sign in to reorder" },
    { "type": "text", "id": "cta_secondary_url", "label": "Secondary link (URL or #anchor)", "default": "/account/login" }
  ],
  "presets": [
    { "name": "Catalog strip", "category": "Homepage" }
  ]
}
{% endschema %}
