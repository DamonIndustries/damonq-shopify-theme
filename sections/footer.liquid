<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href="{{ routes.root_url }}" class="site-header__logo" style="color: var(--ink);">
          {%- if section.settings.footer_logo != blank -%}
            <img
              src="{{ section.settings.footer_logo | image_url: width: 400 }}"
              alt="{{ section.settings.footer_logo_alt | default: shop.name | escape }}"
              style="max-height: {{ section.settings.footer_logo_max_height | default: 36 }}px; width: auto;"
              loading="lazy">
          {%- else -%}
            {% render 'shield-logo', variant: 'dark' %}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <p style="font-size:14px;color:var(--grey);max-width:320px;margin-top:12px;">
          {{ section.settings.brand_blurb }}
        </p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div {{ block.shopify_attributes }}>
            <h5 class="site-footer__heading">{{ block.settings.heading }}</h5>
            <ul class="site-footer__list">
              {%- if block.settings.menu != blank -%}
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- elsif block.settings.raw_links != blank -%}
                {%- assign lines = block.settings.raw_links | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- if line != blank -%}
                    <li>{{ line | strip }}</li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_blurb }}</span>
      <span class="site-footer__helplinks">
        <a href="{{ routes.root_url }}pages/help">Help center</a>
        <span aria-hidden="true">·</span>
        <a href="{{ settings.rep_link_page.url | default: '/pages/contact-rep' }}">{{ settings.rep_link_label | default: 'Contact the Q Team' }}</a>
      </span>
      <span>{{ section.settings.member_blurb }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Footer logo" },
    { "type": "image_picker", "id": "footer_logo", "label": "Footer logo image", "info": "Optional. SVG or PNG with a transparent background works best on the white footer. If not set, the inline shield + shop name is used." },
    { "type": "text", "id": "footer_logo_alt", "label": "Footer logo alt text", "info": "Used for screen readers and SEO. Defaults to the shop name." },
    { "type": "range", "id": "footer_logo_max_height", "label": "Footer logo max height", "min": 20, "max": 80, "step": 2, "default": 36, "unit": "px" },
    { "type": "header", "content": "Copy" },
    { "type": "richtext", "id": "brand_blurb", "label": "Brand blurb", "default": "<p>More than just chemicals — we provide solutions. Manufacturing in Alliance, Ohio since 1938.</p>" },
    { "type": "text", "id": "legal_blurb", "label": "Legal blurb", "default": "Privacy · Terms" },
    { "type": "text", "id": "member_blurb", "label": "Member badges", "default": "SSS Triple S · ISSA · Healthy Schools Campaign" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Programs" },
        { "type": "link_list", "id": "menu", "label": "Menu (preferred)" },
        { "type": "textarea", "id": "raw_links", "label": "Or raw lines", "default": "Healthcare PPD\nFood Processing\nSchools\nQuick Serve\nGreen" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "link_column", "settings": { "heading": "Programs", "raw_links": "Healthcare PPD\nFood Processing\nSchools\nQuick Serve\nGreen" } },
      { "type": "link_column", "settings": { "heading": "Solutions", "raw_links": "Floor Care\nSanitizing\nLaundry\nWare\nRadiator" } },
      { "type": "link_column", "settings": { "heading": "Account", "raw_links": "My orders\nAutoStock\nSaved bundles\nSDS Library\nNet‑30 app" } },
      { "type": "link_column", "settings": { "heading": "Talk to us", "raw_links": "1‑800‑362‑9850\ninfo@damonq.com\n12435 Rockhill NE\nAlliance, OH 44601" } }
    ]
  }
}
{% endschema %}
