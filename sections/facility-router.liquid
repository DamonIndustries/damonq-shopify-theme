        { "type": "facility", "settings": { "key": "auto", "title": "Automotive & radiator shop", "phrase": "automotive & radiator shops" } },
        { "type": "facility", "settings": { "key": "ind", "title": "Industrial & machining", "phrase": "industrial & machining" } },
        { "type": "route", "settings": { "problem_key": "odor", "problem_label": "Odor, drains & grease traps", "title": "Enzyme program, not another fragrance", "body": "Fragrance masks for four hours. A dosed enzyme program digests the organic film in the drain line and the trap so the smell stops being generated in the first place. We start with a two‑week trial on your worst line.", "chemistry": "Enzyme line", "equipment": "Drain dosing pump", "funding": "Not typical", "link_text": "Enzyme page", "link_url": "#enzymes" } },
        { "type": "route", "settings": { "problem_key": "grease", "problem_label": "Baked‑on grease & carbon", "title": "Concentrate plus the right dispenser", "body": "Hoods, fryers and rotisserie carbon are a chemistry‑and‑dilution problem. We spec the concentrate to your soil, then mount a dilution station so your crew stops free‑pouring at four times the cost.", "chemistry": "Non‑butyl concentrate", "equipment": "Wall dilution station", "funding": "Not typical", "link_text": "Equipment page", "link_url": "#equipment" } },
        { "type": "route", "settings": { "problem_key": "floors", "problem_label": "Floors — finish, stripping, scrubbing", "title": "Floor program with the machine included", "body": "Finish, stripper and daily neutral cleaner specced against your substrate — then the autoscrubber sized to your square footage, installed, trained and serviced by our techs.", "chemistry": "Finish & stripper", "equipment": "Autoscrubber", "funding": "Often eligible", "link_text": "Equipment page", "link_url": "#equipment" } },
