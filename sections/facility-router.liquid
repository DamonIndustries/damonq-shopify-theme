    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get routed" },
    { "type": "text", "id": "heading_pre", "label": "Heading line 1", "default": "Tell us the facility" },
    { "type": "text", "id": "heading_post", "label": "Heading line 2", "default": "and the problem." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Not a product search. Two questions and you land on the person who has solved this before — with the chemistry, the equipment and the funding angle already attached." },
    { "type": "header", "content": "Selectors" },
    { "type": "text", "id": "facility_label", "label": "Facility dropdown label", "default": "Your facility" },
    { "type": "text", "id": "problem_label", "label": "Problem dropdown label", "default": "What you're up against" },
    { "type": "text", "id": "default_facility", "label": "Default facility key", "default": "schools", "info": "Must match a Facility block key. Falls back to the first facility." },
    { "type": "text", "id": "default_problem", "label": "Default problem key", "default": "budget", "info": "Must match a Route block problem key. Falls back to the first route." },
    { "type": "header", "content": "Result panel" },
    { "type": "text", "id": "kicker", "label": "Result kicker", "default": "Recommended route" },
    { "type": "text", "id": "typical_prefix", "label": "Facility sentence prefix", "default": "Typical for", "info": "Appended to the route body as “Typical for <facility phrase>.” Leave blank to omit." },
    { "type": "text", "id": "chemistry_label", "label": "Fact 1 label", "default": "Chemistry" },
    { "type": "text", "id": "equipment_label", "label": "Fact 2 label", "default": "Equipment" },
    { "type": "text", "id": "funding_label", "label": "Fact 3 label (accent)", "default": "Funding" },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Book a 15‑minute call →" },
    { "type": "text", "id": "cta_url", "label": "Primary link (URL or #anchor)", "default": "/pages/contact-rep" },
    { "type": "text", "id": "note", "label": "Note beside buttons", "default": "Free sample and SDS attached automatically" },
    { "type": "text", "id": "empty_text", "label": "Text when no routes exist", "default": "Add a Route block to show a recommendation here." }
  ],
  "blocks": [
    {
      "type": "facility",
      "name": "Facility",
      "limit": 12,
      "settings": [
