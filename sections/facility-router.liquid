        { "type": "text", "id": "phrase", "label": "Sentence phrase", "default": "schools & universities", "info": "Used as “Typical for <phrase>.”" }
      ]
    },
    {
      "type": "route",
      "name": "Route (problem → answer)",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "problem_key", "label": "Problem key", "default": "budget", "info": "Short unique id (letters, numbers, dashes)." },
        { "type": "text", "id": "problem_label", "label": "Problem dropdown label", "default": "No capital budget for what we need", "info": "Keep under 50 characters." },
        { "type": "text", "id": "title", "label": "Route title", "default": "Start with the grant, not the quote" },
        { "type": "textarea", "id": "body", "label": "Route body", "default": "Our grant people check which cycles are open for your entity type, tell you honestly whether you qualify, and help write the equipment into the narrative. We have done this paperwork before." },
        { "type": "text", "id": "chemistry", "label": "Chemistry", "default": "Specced after award" },
        { "type": "text", "id": "equipment", "label": "Equipment", "default": "Written into the ask" },
        { "type": "text", "id": "funding", "label": "Funding", "default": "This is the route" },
        { "type": "text", "id": "link_text", "label": "Secondary link text", "default": "Equipment & grants" },
        { "type": "text", "id": "link_url", "label": "Secondary link (URL or #anchor)", "default": "#equipment" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Facility router",
      "category": "Homepage",
      "blocks": [
        { "type": "facility", "settings": { "key": "grocery", "title": "Grocery & retail", "phrase": "grocery & retail" } },
        { "type": "facility", "settings": { "key": "food", "title": "Food processing", "phrase": "food processing" } },
        { "type": "facility", "settings": { "key": "qsr", "title": "Quick service restaurant", "phrase": "quick service restaurants" } },
        { "type": "facility", "settings": { "key": "schools", "title": "Schools & universities", "phrase": "schools & universities" } },
