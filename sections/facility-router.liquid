{%- comment -%}
  Facility / problem router — the homepage's primary call to action.
  Dark panel: facility <select> × problem <select> → recommended route
  (title, body, chemistry / equipment / funding, link). Routes and
  facilities are blocks so the copy is editable in the theme editor.

  The default route is server-rendered (works without JS, indexable), the
  route data is emitted as a JSON blob, and theme.js swaps the panel on
  change. Route blocks match problems by `problem_key`.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign anchor = s.anchor_id | default: 'router'
  assign facilities = section.blocks | where: 'type', 'facility'
  assign routes = section.blocks | where: 'type', 'route'
  assign uid = section.id | handleize

  assign default_facility = s.default_facility | strip
  assign default_problem = s.default_problem | strip

  assign facility_phrase = ''
  for f in facilities
    if f.settings.key == default_facility
      assign facility_phrase = f.settings.phrase
    endif
  endfor
  if facility_phrase == blank and facilities.size > 0
    assign first_facility = facilities | first
    assign default_facility = first_facility.settings.key
    assign facility_phrase = first_facility.settings.phrase
  endif

  assign current = nil
  for r in routes
    if r.settings.problem_key == default_problem
      assign current = r
    endif
  endfor
  if current == nil and routes.size > 0
    assign current = routes | first
    assign default_problem = current.settings.problem_key
  endif
-%}

<section class="page-section router" id="{{ anchor }}">
  <div class="container">
    <div class="router__panel" data-router>
      <div class="router__grid">
        <div class="router__intro">
          {%- if s.eyebrow != blank -%}
            <span class="eyebrow eyebrow--on-dark">
              {%- if s.eyebrow_no != blank -%}<span>{{ s.eyebrow_no }}</span>{%- endif -%}
              <span class="eyebrow__rule" aria-hidden="true"></span>
              <span>{{ s.eyebrow }}</span>
            </span>
          {%- endif -%}
          <h2 class="router__title">
            {{ s.heading_pre }}
            {%- if s.heading_post != blank -%}<br>{{ s.heading_post }}{%- endif -%}
          </h2>
          {%- if s.subheading != blank -%}
            <p class="router__sub">{{ s.subheading }}</p>
          {%- endif -%}

          <div class="router__field">
            <label class="router__label" for="router-facility-{{ uid }}">{{ s.facility_label }}</label>
            <select class="router__select" id="router-facility-{{ uid }}" name="facility" data-router-facility>
              {%- for f in facilities -%}
                <option value="{{ f.settings.key | escape }}"{% if f.settings.key == default_facility %} selected{% endif %}>{{ f.settings.title | escape }}</option>
              {%- endfor -%}
            </select>
          </div>
          <div class="router__field">
            <label class="router__label" for="router-problem-{{ uid }}">{{ s.problem_label }}</label>
            <select class="router__select" id="router-problem-{{ uid }}" name="problem" data-router-problem>
              {%- for r in routes -%}
                <option value="{{ r.settings.problem_key | escape }}"{% if r.settings.problem_key == default_problem %} selected{% endif %}>{{ r.settings.problem_label | escape }}</option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        <div class="route" aria-live="polite" aria-atomic="true">
          {%- if s.kicker != blank -%}
            <div class="route__kicker">{{ s.kicker }}</div>
          {%- endif -%}
          {%- if current -%}
            {%- assign c = current.settings -%}
            <h3 class="route__title" data-route-title>{{ c.title | escape }}</h3>
            <p class="route__body" data-route-body>{{ c.body | escape }}{% if s.typical_prefix != blank and facility_phrase != blank %} {{ s.typical_prefix | escape }} {{ facility_phrase | escape }}.{% endif %}</p>
            <div class="route__facts">
              <div class="route__fact"><div class="route__fact-k">{{ s.chemistry_label }}</div><div class="route__fact-v" data-route-chemistry>{{ c.chemistry | escape }}</div></div>
              <div class="route__fact"><div class="route__fact-k">{{ s.equipment_label }}</div><div class="route__fact-v" data-route-equipment>{{ c.equipment | escape }}</div></div>
              <div class="route__fact"><div class="route__fact-k">{{ s.funding_label }}</div><div class="route__fact-v route__fact-v--accent" data-route-funding>{{ c.funding | escape }}</div></div>
            </div>
            <div class="route__ctas">
              {%- if s.cta_text != blank -%}
                <a href="{{ s.cta_url }}" class="btn btn--red">{{ s.cta_text }}</a>
              {%- endif -%}
              <a href="{{ c.link_url | default: '#' }}" class="btn btn--outline-on-dark" data-route-link{% if c.link_text == blank %} hidden{% endif %}>{{ c.link_text | escape }}</a>
              {%- if s.note != blank -%}
                <span class="route__note">{{ s.note }}</span>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="route__body">{{ s.empty_text }}</p>
          {%- endif -%}
        </div>
      </div>

      <script type="application/json" data-router-routes>
        {
          "typical": {{ s.typical_prefix | json }},
          "facilities": {
            {%- for f in facilities -%}
              {{ f.settings.key | json }}: {{ f.settings.phrase | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          },
          "routes": {
            {%- for r in routes -%}
              {{ r.settings.problem_key | json }}: {
                "title": {{ r.settings.title | json }},
                "body": {{ r.settings.body | json }},
                "chemistry": {{ r.settings.chemistry | json }},
                "equipment": {{ r.settings.equipment | json }},
                "funding": {{ r.settings.funding | json }},
                "link_text": {{ r.settings.link_text | json }},
                "link_url": {{ r.settings.link_url | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          }
        }
      </script>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Facility router",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "router", "info": "Used by in-page links and the section rail. Letters, numbers and dashes only." },
